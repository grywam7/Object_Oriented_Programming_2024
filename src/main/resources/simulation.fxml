<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            minHeight="550.0" minWidth="850.0"
            fx:controller="agh.ics.oop.presenter.SimulationPresenter">
    <top>
        <HBox spacing="10">
            <TextField fx:id="movesTextField" promptText="Enter moves (e.g. F,R,L)"/>
            <Label fx:id="statusLabel" text="Status messages will appear here!"/>
        </HBox>
    </top>

    <center>
        <HBox alignment="CENTER">
            <VBox alignment="CENTER">
                <GridPane fx:id="mapGrid" gridLinesVisible="true"/>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox>
            <Button text="Start" onAction="#onSimulationStartClicked"/>
        </HBox>
    </bottom>

</BorderPane>
